# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-output-of-node-e-console.log(require('crypto').randomBytes(32).toString('base64'))

# Discord OAuth App (create at https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Discord server config
DISCORD_GUILD_ID=
DISCORD_ADMIN_ROLE_ID=

# Supabase (same project the bot uses)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Upstash Redis (create at https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
