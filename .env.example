# Discord Bot
TOKEN=your_discord_bot_token
PROXY=socks5://127.0.0.1:10808

# Supabase (get from Supabase dashboard → Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Feishu custom app and Base targets
FEISHU_APP_ID=cli_your_app_id
FEISHU_APP_SECRET=your_app_secret
FEISHU_UPDATES_BASE_APP_TOKEN=your_updates_base_app_token
FEISHU_UPDATES_TABLE_ID=your_updates_table_id
FEISHU_METRICS_BASE_APP_TOKEN=your_metrics_base_app_token
FEISHU_METRICS_TABLE_ID=your_metrics_table_id
FEISHU_NOTIFY_CHAT_ID=

# Financial support keyword redirect
SUPPORT_REDIRECT_ENABLED=0
SUPPORT_TRIGGER_CHANNEL_IDS=1546766591096787026,1546766625209065492,1546766642820677652
SUPPORT_CHANNEL_ID=1509148079566225480
SUPPORT_REDIRECT_COOLDOWN_SECONDS=600

# Screenshot proof code activity
SCREENSHOT_ACTIVITY_CHANNEL_ID=discord_submission_channel_id
SCREENSHOT_CODES_SPREADSHEET_TOKEN=lark_spreadsheet_token
SCREENSHOT_CODES_SHEET_ID=lark_sheet_id
